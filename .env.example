# Optional settings. Copy this file to ".env" (no .example) and fill in what you want.

# Claude writes the Chief's verdict when this is set. One call every 15 minutes while the dashboard is open
# (about 96 calls a day if left open all day): roughly 2 to 5 US dollars per full day on Claude Opus 5.5.
# Get a key at https://console.anthropic.com  ->  API Keys.
ANTHROPIC_API_KEY=

# XAUS needs no key. Leave empty.
XAUS_API_KEY=

# Agent vote weights from their own last 60 days of results (computed and shown either way). 1 = use them.
USE_PERFORMANCE_WEIGHTS=0

